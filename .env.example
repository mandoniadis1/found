# found. needs exactly one key. Put this file's contents in a file named .env in this folder,
# or one folder up (the app checks this folder first, then its parent).
PORTKEY_API_KEY=your-portkey-key-here

# ---------------------------------------------------------------------------------------------
# Everything below is OPTIONAL and off by default. The app runs fully without any of it
# (local mode: emails are shown in the browser instead of sent; LinkedIn uses a labeled stand-in).
# ---------------------------------------------------------------------------------------------
# FOUND_DEV_MODE=1                    # 1 = local mode (default). Set 0 only on a real deployment.
# FRONTEND_URL=http://localhost:8030  # where links in emails point
# ADMIN_EMAILS=you@yale.edu           # extra admin accounts (local mode also has admin@yale.edu)
# MAIL_MODE=outbox                    # outbox (default, nothing sent) | smtp | outlook
# REFRESH_DAYS=7                      # re-download the two source sites every N days (0 = off)
# SCOUT_VISITOR_DAILY_TOKENS=8000     # Scout helper budgets (gpt-6-luna)
# SCOUT_DAILY_TOKENS=100000
